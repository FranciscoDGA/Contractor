---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../config';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide }
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'sources' && h.slug !== 'frequently-asked-questions');

const words = (guide.body ?? '').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 220));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    datePublished: guide.data.published.toISOString(),
    dateModified: guide.data.updated.toISOString(),
    inLanguage: 'en-US',
    mainEntityOfPage: `${SITE_URL}/guides/${guide.id}/`
  },
  ...(toc.length > 1
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
            { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/guides/` },
            { '@type': 'ListItem', position: 3, name: guide.data.title, item: `${SITE_URL}/guides/${guide.id}/` }
          ]
        }
      ]
    : []),
  ...(guide.data.faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: guide.data.faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: { '@type': 'Answer', text: item.a }
          }))
        }
      ]
    : [])
];
---

<BaseLayout title={guide.data.title} description={guide.data.description} jsonLd={jsonLd}>
  <article class="container prose">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/guides/">Guides</a> / {guide.data.title}
    </nav>

    <div class="guide-head">
      <span class="badge">{guide.data.cluster === 'forensic' ? 'Quote forensics' : guide.data.cluster === 'cost' ? 'Cost check' : guide.data.cluster === 'state' ? 'Rights by state' : 'Tool'}</span>
      <h1>{guide.data.title}</h1>
    </div>
    <div class="guide-meta">
      <span>Published {guide.data.published.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      <span class="dot">·</span>
      <span>Updated {guide.data.updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      <span class="dot">·</span>
      <span>{readMin} min read</span>
    </div>

    {toc.length > 2 && (
      <nav class="toc" aria-label="Table of contents">
        <div class="label">On this page</div>
        <ul>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ul>
      </nav>
    )}

    <Content />

    {guide.data.faq.length > 0 && (
      <>
        <h2 id="faq">Frequently asked questions</h2>
        {guide.data.faq.map((item) => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </>
    )}

    <div class="inline-cta">
      <div>
        <h3>Got a quote in your hand?</h3>
        <p>Run it against published national ranges in 30 seconds — free, in your browser.</p>
      </div>
      <a class="btn" href="/tools/quote-fairness/">Check my quote</a>
    </div>

    <div class="disclaimer-box">
      Educational information about price, process, and consumer rights — not an
      inspection, appraisal, structural opinion, or legal advice. We are not
      licensed contractors. For safety, code, or engineering questions, consult
      your local building authority or a licensed professional.
    </div>

    <p><a href="/guides/">← All guides</a></p>
  </article>
</BaseLayout>
