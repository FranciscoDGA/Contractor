---
import type { CollectionEntry } from 'astro:content';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const date = guide.data.published.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});

const clusterLabel: Record<string, string> = {
  forensic: 'Quote forensics',
  cost: 'Cost check',
  state: 'Rights by state',
  tool: 'Tool'
};
---

<a class="card guide-card" href={`/guides/${guide.id}/`}>
  <div class="meta">{clusterLabel[guide.data.cluster] ?? guide.data.cluster} · {date}</div>
  <h3>{guide.data.title}</h3>
  <p>{guide.data.description}</p>
  <span class="card-cta">Read the guide →</span>
</a>
