---
import type { CollectionEntry } from 'astro:content';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const date = guide.data.published.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

<a class="card guide-card" href={`/guides/${guide.id}/`}>
  <div class="meta">{guide.data.cluster} · {date}</div>
  <h3>{guide.data.title}</h3>
  <p>{guide.data.description}</p>
</a>
